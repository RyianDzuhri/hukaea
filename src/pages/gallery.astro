---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import { gallery } from "../data/gallery";

// Daftar rasio aspek acak untuk memvariasikan ukuran gambar (Masonry Grid)
const aspectRatios = [
  "aspect-square",
  "aspect-[4/5]",
  "aspect-[3/4]",
  "aspect-[4/3]",
  "aspect-[16/9]"
];
---

<MainLayout title="Galeri Desa Hukaea">

  <!-- Tombol Kembali ke Beranda -->
  <a
    href="/"
    class="fixed top-6 left-6 z-40 flex items-center gap-2 rounded-full bg-white/90 px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-md backdrop-blur-md transition-all duration-300 hover:bg-green-600 hover:text-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Kembali ke Beranda
  </a>

  <section class="relative bg-slate-50 pt-28 pb-20 min-h-screen">

    <div class="container mx-auto px-6">

      <div class="mx-auto max-w-3xl text-center">

        <span
          class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700"
        >
          Galeri Desa
        </span>

        <h1
          class="mt-6 text-4xl sm:text-5xl font-black text-slate-900 tracking-tight"
        >
          Dokumentasi Desa Hukaea
        </h1>

        <p
          class="mt-6 text-lg leading-relaxed text-slate-500"
        >
          Seluruh dokumentasi kegiatan, fasilitas, potensi,
          dan keindahan Desa Hukaea.
        </p>

      </div>

      <!-- Filter Buttons -->
      <div
        id="filter"
        class="mt-12 flex flex-wrap justify-center gap-3"
      >
        <button
          class="filter-btn rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-300"
          data-category="all"
        >
          Semua
        </button>
      </div>

      <!-- Gallery (Masonry Grid dengan Komponen Astro Image) -->
      <div
        id="gallery"
        class="mt-14 columns-2 md:columns-3 lg:columns-4 gap-5 space-y-5"
      >
        {
          gallery.map((photo, index) => {
            const randomAspect = aspectRatios[index % aspectRatios.length];
            const optimizedSrc = typeof photo.image === "string" ? photo.image : photo.image.src;
            
            return (
              <button
                class="gallery-item group relative block w-full overflow-hidden rounded-3xl break-inside-avoid cursor-pointer focus:outline-none shadow-sm hover:shadow-xl transition-all duration-300"
                data-category={photo.category}
                data-src={optimizedSrc}
                data-index={index}
              >
                <!-- Komponen Astro Image -->
                <Image
                  src={photo.image}
                  alt={`Dokumentasi ${photo.category} Desa Hukaea`}
                  width={600}
                  format="webp"
                  quality={80}
                  loading={index < 4 ? "eager" : "lazy"}
                  class={`w-full object-cover transition duration-500 group-hover:scale-105 ${randomAspect}`}
                />

                <!-- Overlay Hover (Hanya Ikon "Lihat Foto" & Badge Kategori) -->
                <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-4">
                  <div class="flex justify-end">
                    <span class="rounded-full bg-green-600/90 px-3 py-1 text-[11px] font-medium text-white backdrop-blur-md capitalize">
                      {photo.category}
                    </span>
                  </div>
                  <div class="flex items-center justify-center">
                    <span class="bg-white/90 text-slate-800 text-xs font-semibold px-4 py-2 rounded-full shadow-lg backdrop-blur-sm flex items-center gap-1.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      Lihat Foto
                    </span>
                  </div>
                  <div></div>
                </div>

              </button>
            );
          })
        }
      </div>

    </div>

  </section>

  <!-- Lightbox Modal -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300"
  >
    <!-- Tombol Close -->
    <button
      id="lightbox-close"
      class="absolute top-6 right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-colors z-10"
      aria-label="Tutup foto"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Tombol Prev -->
    <button
      id="lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-colors z-10 hidden sm:block"
      aria-label="Foto sebelumnya"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Tombol Next -->
    <button
      id="lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-colors z-10 hidden sm:block"
      aria-label="Foto selanjutnya"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Konten Gambar Modal -->
    <div class="relative max-w-5xl max-h-[85vh] flex flex-col items-center">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[80vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl"
      />
      <!-- Keterangan Lightbox (Menampilkan Nama Kategori Saja) -->
      <span id="lightbox-caption" class="mt-4 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-green-300 backdrop-blur-sm"></span>
    </div>
  </div>

</MainLayout>

<style>
  .filter-btn {
    transition: all .3s ease;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const items = [...document.querySelectorAll(".gallery-item")];
  const filterContainer = document.getElementById("filter");

  // Elemen Lightbox
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  let visibleItems = [...items];
  let currentIndex = 0;

  if (!filterContainer || !lightbox) return;

  // 1. Kategori Filter Dynamic
  const categories = [
    "all",
    ...new Set(
      items
        .map(item => item.dataset.category?.trim())
        .filter(category => category && category.length > 0)
    )
  ];

  categories.forEach(category => {
    if (category === "all") return;

    const btn = document.createElement("button");
    btn.className =
      "filter-btn rounded-full border border-green-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition-all duration-300 hover:bg-green-600 hover:text-white hover:border-green-600 shadow-sm";
    btn.dataset.category = category;
    btn.textContent = category.charAt(0).toUpperCase() + category.slice(1);

    filterContainer.appendChild(btn);
  });

  const buttons = document.querySelectorAll(".filter-btn");

  buttons.forEach(button => {
    button.addEventListener("click", () => {
      buttons.forEach(btn => {
        btn.classList.remove("bg-green-600", "text-white", "border-green-600");
        btn.classList.add("bg-white", "text-slate-700", "border", "border-green-200");
      });

      button.classList.remove("bg-white", "text-slate-700", "border-green-200");
      button.classList.add("bg-green-600", "text-white", "border-green-600");

      const category = button.dataset.category;

      visibleItems = items.filter(item => {
        if (category === "all" || item.dataset.category === category) {
          item.classList.remove("hidden");
          item.classList.add("block");
          return true;
        } else {
          item.classList.add("hidden");
          item.classList.remove("block");
          return false;
        }
      });
    });
  });

  // 2. Fitur Lightbox / Pop-up Foto
  function updateLightbox(index) {
    if (visibleItems.length === 0) return;
    currentIndex = (index + visibleItems.length) % visibleItems.length;
    const targetItem = visibleItems[currentIndex];

    lightboxImg.src = targetItem.dataset.src || "";
    // Menggunakan Nama Kategori untuk Keterangan Lightbox (Tanpa Nama File)
    const categoryName = targetItem.dataset.category || "";
    lightboxCaption.textContent = categoryName ? `Kategori: ${categoryName}` : "Dokumentasi Desa";
  }

  function openLightbox(index) {
    updateLightbox(index);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "auto";
  }

  items.forEach(item => {
    item.addEventListener("click", () => {
      const idx = visibleItems.indexOf(item);
      if (idx !== -1) openLightbox(idx);
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", () => updateLightbox(currentIndex - 1));
  nextBtn?.addEventListener("click", () => updateLightbox(currentIndex + 1));

  // Tutup jika klik area di luar gambar
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Navigasi Keyboard
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") updateLightbox(currentIndex - 1);
    if (e.key === "ArrowRight") updateLightbox(currentIndex + 1);
  });
});
</script>