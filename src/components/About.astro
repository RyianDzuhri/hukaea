---
import { Check, ArrowRight } from "lucide-astro";
import { village } from "../data/village";
import aboutImage from "../assets/images/about-desa.jpg";
---

<section
    id="profil"
    class="relative overflow-hidden py-20 md:py-24 lg:py-32"
>

    <!-- Background Blur -->

    <div
        class="absolute -left-40 top-20 h-[420px] w-[420px] rounded-full bg-green-100 blur-[140px]"
    />

    <div
        class="absolute -right-40 bottom-0 h-[420px] w-[420px] rounded-full bg-emerald-100 blur-[140px]"
    />

    <div class="container relative z-10 mx-auto px-6">

        <div
            class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:items-center"
        >

            <!-- FOTO -->

            <div
                class="relative mx-auto w-full max-w-sm lg:max-w-[380px]"
            >

                <img
                    src={aboutImage.src}
                    alt="Desa Hukaea"
                    class="aspect-[4/5] w-full rounded-[30px] object-cover shadow-[0_20px_60px_rgba(0,0,0,.12)]"
                />

                <div
                    class="absolute bottom-4 right-4 rounded-2xl border border-white/40 bg-white/90 px-4 py-3 backdrop-blur-xl shadow-lg md:bottom-5 md:right-5 md:px-5 md:py-4"
                >

                    <p
                        class="text-xs text-gray-500"
                    >
                        Kabupaten
                    </p>

                    <h3
                        class="text-base font-bold text-slate-900 md:text-lg"
                    >
                        Bombana
                    </h3>

                </div>

            </div>

            <!-- CONTENT -->

            <div>

                <span
                    class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700"
                >
                    Tentang Desa
                </span>

                <h2
                    class="mt-6 max-w-3xl text-3xl font-black leading-tight text-slate-900 md:text-4xl lg:text-5xl"
                >
                    Membangun Desa yang Modern,
                    Transparan, dan Berkelanjutan.
                </h2>

                <p
                    class="mt-6 max-w-3xl text-base leading-8 text-slate-600 md:text-lg md:leading-9"
                >
                    {village.about.description}
                </p>

                <div
                    class="mt-8 grid gap-5 sm:grid-cols-2"
                >

                    {
                        village.about.highlights.map((item) => (

                            <div
                                class="flex items-start gap-4"
                            >

                                <div
                                    class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-green-100"
                                >

                                    <Check
                                        class="h-5 w-5 text-green-700"
                                    />

                                </div>

                                <span
                                    class="leading-7 text-slate-700"
                                >
                                    {item}
                                </span>

                            </div>

                        ))
                    }

                </div>

                <a
                    href="#potensi"
                    class="group mt-10 inline-flex items-center gap-3 rounded-2xl bg-green-600 px-7 py-4 font-semibold text-white transition-all duration-300 hover:bg-green-700 hover:shadow-xl"
                >

                    Jelajahi Potensi Desa

                    <ArrowRight
                        class="transition-transform duration-300 group-hover:translate-x-1"
                    />

                </a>

            </div>

        </div>

    </div>

</section>