---
import {
    MapPin,
    Phone,
    Mail,
    Facebook,
    Instagram,
    Youtube,
} from "lucide-astro";

import logo from "../assets/images/logo-desa.png";
import { village } from "../data/village";
---

<footer class="relative mt-12 overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-green-950 text-white">

    <div class="absolute -left-32 -top-32 h-72 w-72 rounded-full bg-green-500/20 blur-[120px]" />
    <div class="absolute -right-32 bottom-0 h-72 w-72 rounded-full bg-emerald-500/20 blur-[120px]" />

    <div class="container relative z-10 mx-auto max-w-7xl px-6 py-14">

        <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr_1fr]">

            <!-- Logo -->

            <div>

                <div class="flex items-center gap-4">

                    <img
                        src={logo.src}
                        alt="Logo Desa"
                        class="h-12 w-12"
                    />

                    <div>

                        <h3 class="text-xl font-bold">
                            {village.name}
                        </h3>

                        <p class="text-sm text-slate-400">
                            Website Resmi Desa
                        </p>

                    </div>

                </div>

                <p class="mt-5 max-w-sm leading-7 text-slate-400">
                    {village.description}
                </p>

            </div>

            <!-- Menu -->

            <div>

                <h4 class="font-semibold text-lg">
                    Menu
                </h4>

                <div class="mt-5 grid grid-cols-2 gap-y-3">

                    <a href="#beranda" class="text-slate-400 hover:text-green-400">Beranda</a>

                    <a href="#profil" class="text-slate-400 hover:text-green-400">Profil</a>

                    <a href="#potensi" class="text-slate-400 hover:text-green-400">Potensi</a>

                    <a href="#galeri" class="text-slate-400 hover:text-green-400">Galeri</a>

                    <a href="#visi-misi" class="text-slate-400 hover:text-green-400">Visi Misi</a>

                    <a href="#kontak" class="text-slate-400 hover:text-green-400">Kontak</a>

                </div>

            </div>

            <!-- Kontak -->

            <div>

                <h4 class="font-semibold text-lg">
                    Hubungi Kami
                </h4>

                <div class="mt-5 space-y-4">

                    <div class="flex gap-3">

                        <MapPin class="mt-1 h-5 w-5 text-green-400"/>

                        <span class="leading-7 text-slate-400">
                            {village.contact.address}
                        </span>

                    </div>

                    <div class="flex gap-3">

                        <Phone class="h-5 w-5 text-green-400"/>

                        <span class="text-slate-400">
                            {village.contact.phone}
                        </span>

                    </div>

                    <div class="flex gap-3">

                        <Mail class="h-5 w-5 text-green-400"/>

                        <span class="break-all text-slate-400">
                            {village.contact.email}
                        </span>

                    </div>

                </div>

                <div class="mt-7 flex gap-3">

                    <a href="#" class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 hover:bg-green-600">

                        <Facebook class="h-5 w-5"/>

                    </a>

                    <a href="#" class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 hover:bg-green-600">

                        <Instagram class="h-5 w-5"/>

                    </a>

                    <a href="#" class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 hover:bg-green-600">

                        <Youtube class="h-5 w-5"/>

                    </a>

                </div>

            </div>

        </div>

        <div class="mt-10 border-t border-white/10 pt-6">

            <div class="flex flex-col gap-3 text-center text-sm text-slate-500 md:flex-row md:items-center md:justify-between">

                <p>
                    © 2026 <span class="font-semibold text-slate-300">Desa Hukaea</span>. Seluruh hak cipta dilindungi.
                </p>

                <p>
                    Dikembangkan oleh <span class="font-semibold text-green-400">Mahasiswa KKN Universitas Halu Oleo</span>
                </p>

            </div>

        </div>

    </div>

</footer>