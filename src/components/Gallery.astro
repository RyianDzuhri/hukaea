---
import { gallery } from "../data/gallery";

const previewGallery = gallery.slice(0, 8);
---

<section
    id="galeri"
    class="relative overflow-hidden bg-slate-50 py-32"
>
    <!-- Background -->
    <div
        class="absolute -left-40 top-0 h-[420px] w-[420px] rounded-full bg-green-100 blur-[140px]"
    />

    <div
        class="absolute -right-40 bottom-0 h-[420px] w-[420px] rounded-full bg-emerald-100 blur-[140px]"
    />

    <div class="container relative z-10 mx-auto px-6">

        <!-- Heading -->

        <div class="mx-auto max-w-3xl text-center">

            <span
                class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700"
            >
                Galeri Desa
            </span>

            <h2
                class="mt-6 text-4xl font-black text-slate-900 md:text-5xl"
            >
                Dokumentasi Desa Hukaea
            </h2>

            <p
                class="mt-6 text-lg leading-8 text-slate-500"
            >
                Dokumentasi berbagai kegiatan, fasilitas, potensi,
                dan keindahan Desa Hukaea.
            </p>

        </div>

        <!-- Gallery -->

        <div
            class="mx-auto mt-16 grid max-w-7xl gap-5 grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
        >

            {
                previewGallery.map((photo) => (

                    <div
                        class="group overflow-hidden rounded-[26px] bg-white shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
                    >

                        <div
                            class="relative aspect-[4/5] overflow-hidden"
                        >

                            <img
                                src={photo.image.src}
                                width={photo.image.width}
                                height={photo.image.height}
                                alt="Galeri Desa Hukaea"
                                loading="lazy"
                                class="h-full w-full object-cover transition duration-700 group-hover:scale-110"
                            />

                            <!-- Overlay -->

                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
                            />

                        </div>

                    </div>

                ))
            }

        </div>

        <!-- Button -->

        <div class="mt-14 text-center">

            <a
                href="/gallery"
                class="inline-flex rounded-full bg-green-600 px-8 py-4 font-semibold text-white transition hover:bg-green-700"
            >
                Lihat Seluruh Galeri
            </a>

        </div>

    </div>

</section>