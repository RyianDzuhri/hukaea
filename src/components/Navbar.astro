---
import logoDesa from "../assets/images/logo-desa.png";
import { Menu } from "lucide-astro";

export interface Props {
    alwaysScrolled?: boolean;
}
const { alwaysScrolled = false } = Astro.props;
---

<header id="navbar" class:list={["navbar", { "navbar-scrolled": alwaysScrolled }]} data-always-scrolled={alwaysScrolled.toString()}>

    <div class="container mx-auto flex h-20 items-center justify-between px-6">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3">

            <img
                src={logoDesa.src}
                alt="Logo Desa"
                class="h-11 w-11 object-contain"
            />

            <div class="leading-tight">

                <h1 class="text-xl font-bold">
                    Desa Hukaea
                </h1>

                <p class="text-sm">
                    Website Profil Desa
                </p>

            </div>

        </a>

        <!-- Desktop -->
        <nav class="hidden md:flex items-center gap-8">

            <a href="/#beranda">Beranda</a>
            <a href="/#profil">Profil</a>
            <a href="/#visi-misi">Visi & Misi</a>
            <a href="/#organisasi">Organisasi</a>
            <a href="/#potensi">Potensi</a>
            <a href="/infografis">Infografis</a>
            <a href="/#galeri">Galeri</a>

            <a href="/#kontak" class="btn-kontak">
                Kontak
            </a>

        </nav>

        <!-- Mobile -->
        <button
            id="menuBtn"
            class="md:hidden"
        >
            <Menu class="h-8 w-8" />
        </button>

    </div>

    <!-- Dropdown HP -->

    <div id="mobileMenu" class="mobile-menu">

        <a href="/#beranda">Beranda</a>

        <a href="/#profil">Profil</a>

        <a href="/#visi-misi">Visi & Misi</a>

        <a href="/#organisasi">Struktur Organisasi</a>

        <a href="/#potensi">Potensi</a>

        <a href="/infografis">Infografis</a>

        <a href="/#galeri">Galeri</a>

        <a href="/#kontak">
            Kontak
        </a>

    </div>

</header>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const navbar = document.getElementById("navbar")!;
    const menuBtn = document.getElementById("menuBtn")!;
    const mobileMenu = document.getElementById("mobileMenu")!;

    if (!navbar || !menuBtn || !mobileMenu) return;

    const alwaysScrolled = navbar.getAttribute("data-always-scrolled") === "true";

    function handleScroll() {
        if (alwaysScrolled || window.scrollY > 20) {
            navbar.classList.add("navbar-scrolled");
        } else {
            navbar.classList.remove("navbar-scrolled");
        }
    }

    menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("show");
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.remove("show");
        });
    });

    handleScroll();

    window.addEventListener("scroll", handleScroll);

});
</script>

<style>
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    color: white;
    background: transparent;
    transition: all .3s ease;
}

.navbar a {
    color: inherit;
    text-decoration: none;
    transition: .25s;
}

.navbar a:hover {
    color: #16a34a;
}

/* Tombol Kontak */

.btn-kontak {
    padding: .75rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.7);
    transition: .25s;
}

.btn-kontak:hover {
    background: white;
    color: #16a34a !important;
}

/* Navbar saat scroll */

.navbar-scrolled {
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255,255,255,.3);

    color: #0f172a;

    box-shadow: 0 8px 25px rgba(0,0,0,.08);
}

.navbar-scrolled .btn-kontak {
    border-color: #16a34a;
    color: #16a34a;
}

.navbar-scrolled .btn-kontak:hover {
    background: #16a34a;
    color: white !important;
}

/* ========================= */
/* MOBILE MENU */
/* ========================= */

.mobile-menu {
    display: none;
}

@media (max-width: 767px) {

    .mobile-menu {

        display: block;

        position: absolute;

        top: 80px;

        left: 16px;

        right: 16px;

        background: white;

        border-radius: 18px;

        overflow: hidden;

        box-shadow: 0 20px 40px rgba(0,0,0,.12);

        max-height: 0;

        opacity: 0;

        transition: .35s ease;
    }

    .mobile-menu.show {

        max-height: 600px;

        opacity: 1;
    }

    .mobile-menu a {

        display: block;

        padding: 18px 22px;

        color: #0f172a;

        font-weight: 600;

        border-bottom: 1px solid #e2e8f0;
    }

    .mobile-menu a:last-child {

        border-bottom: none;
    }

    .mobile-menu a:hover {

        background: #f0fdf4;

        color: #16a34a;
    }

}
</style>