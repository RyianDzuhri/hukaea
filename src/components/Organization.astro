---
import { X, ZoomIn } from "lucide-astro";
import strukturOrganisasi from "../assets/images/struktur-organisasi.jpeg";
---

<section
    id="organisasi"
    class="relative overflow-hidden bg-slate-50 py-32"
>

    <!-- Background -->
    <div class="absolute -left-40 top-0 h-[420px] w-[420px] rounded-full bg-green-100 blur-[140px]"></div>
    <div class="absolute -right-40 bottom-0 h-[420px] w-[420px] rounded-full bg-emerald-100 blur-[140px]"></div>

    <div class="container relative z-10 mx-auto px-6">

        <!-- Heading -->
        <div class="mx-auto max-w-3xl text-center">

            <span class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700">
                Pemerintah Desa
            </span>

            <h2 class="mt-6 text-5xl font-black text-slate-900">
                Struktur Organisasi Desa
            </h2>

            <p class="mt-6 text-lg leading-8 text-slate-500">
                Susunan organisasi Pemerintah Desa Hukaea sebagai bentuk
                transparansi penyelenggaraan pemerintahan desa.
            </p>

        </div>

        <!-- Gambar -->
        <div class="group mx-auto mt-16 max-w-6xl overflow-hidden rounded-[32px] border border-white/60 bg-white p-5 shadow-[0_20px_60px_rgba(0,0,0,.08)]">

            <button
                id="openImage"
                class="relative block w-full overflow-hidden rounded-2xl"
            >

                <img
                    src={strukturOrganisasi.src}
                    alt="Struktur Organisasi Desa"
                    class="w-full rounded-2xl transition duration-500 group-hover:scale-[1.02]"
                />

                <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition duration-300 group-hover:bg-black/20">

                    <div class="flex items-center gap-2 rounded-full bg-white/90 px-5 py-3 font-semibold text-slate-800 opacity-0 transition duration-300 group-hover:opacity-100">

                        <ZoomIn class="h-5 w-5" />

                        Perbesar

                    </div>

                </div>

            </button>

        </div>

    </div>

</section>

<!-- Modal -->

<div
    id="imageModal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-6"
>

    <button
        id="closeImage"
        class="absolute right-6 top-6 flex h-12 w-12 items-center justify-center rounded-full bg-white text-slate-800 transition hover:bg-red-600 hover:text-white"
    >
        <X class="h-7 w-7" />
    </button>

    <img
        src={strukturOrganisasi.src}
        alt="Struktur Organisasi Desa"
        class="max-h-[90vh] max-w-[95vw] rounded-2xl shadow-2xl"
    />

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const modal = document.getElementById("imageModal");
    const open = document.getElementById("openImage");
    const close = document.getElementById("closeImage");

    function showModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function hideModal() {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
        document.body.style.overflow = "";
    }

    open?.addEventListener("click", showModal);

    close?.addEventListener("click", hideModal);

    modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
            hideModal();
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            hideModal();
        }
    });

});
</script>