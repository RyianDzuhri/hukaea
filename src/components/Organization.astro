---
import { ImageOff, ZoomIn } from "lucide-astro";
---

<section
    id="organisasi"
    class="relative overflow-hidden bg-slate-50 py-32"
>

    <!-- Background -->

    <div
        class="absolute -left-40 top-0 h-[420px] w-[420px] rounded-full bg-green-100 blur-[140px]"
    />

    <div
        class="absolute -right-40 bottom-0 h-[420px] w-[420px] rounded-full bg-emerald-100 blur-[140px]"
    />

    <div class="container relative z-10 mx-auto px-6">

        <!-- Heading -->

        <div class="mx-auto max-w-3xl text-center">

            <span
                class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700"
            >
                Pemerintah Desa
            </span>

            <h2
                class="mt-6 text-5xl font-black text-slate-900"
            >
                Struktur Organisasi Desa
            </h2>

            <p
                class="mt-6 text-lg leading-8 text-slate-500"
            >
                Susunan organisasi Pemerintah Desa Hukaea sebagai bentuk
                transparansi penyelenggaraan pemerintahan desa.
            </p>

        </div>

        <!-- Placeholder -->

        <div
            class="group mx-auto mt-16 max-w-6xl overflow-hidden rounded-[36px] border border-white/60 bg-white shadow-[0_20px_60px_rgba(0,0,0,.08)]"
        >

            <div
                class="flex h-[600px] flex-col items-center justify-center bg-gradient-to-br from-green-50 via-white to-green-100"
            >

                <div
                    class="flex h-28 w-28 items-center justify-center rounded-[28px] bg-green-100 transition duration-300 group-hover:scale-110"
                >

                    <ImageOff
                        class="h-14 w-14 text-green-700"
                    />

                </div>

                <h3
                    class="mt-8 text-3xl font-bold text-slate-900"
                >
                    Struktur Organisasi Belum Tersedia
                </h3>

                <p
                    class="mt-4 max-w-xl text-center leading-8 text-slate-500"
                >
                    Gambar struktur organisasi Pemerintah Desa Hukaea akan
                    ditampilkan di sini setelah data resmi tersedia.
                </p>

            </div>

        </div>

        <div
            class="mt-8 flex items-center justify-center gap-3 text-green-700"
        >

            <ZoomIn class="h-5 w-5" />

            <span>
                Struktur organisasi akan diperbarui pada versi berikutnya.
            </span>

        </div>

    </div>

</section>