---
import { Target, CheckCircle2 } from "lucide-astro";
import { village } from "../data/village";
---

<section
    id="visi-misi"
    class="relative overflow-hidden bg-slate-50 py-24"
>

    <!-- Background -->

    <div
        class="absolute -left-40 top-0 h-[400px] w-[400px] rounded-full bg-green-100 blur-[130px]"
    />

    <div
        class="absolute -right-40 bottom-0 h-[400px] w-[400px] rounded-full bg-emerald-100 blur-[130px]"
    />

    <div class="container relative z-10 mx-auto px-6">

        <!-- Heading -->

        <div class="mx-auto max-w-3xl text-center">

            <span
                class="inline-flex rounded-full bg-green-100 px-5 py-2 text-sm font-semibold text-green-700"
            >
                Visi & Misi
            </span>

            <h2
                class="mt-5 text-4xl font-black tracking-tight text-slate-900 md:text-5xl"
            >
                Arah Pembangunan Desa
            </h2>

            <p
                class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-500"
            >
                Visi dan misi menjadi pedoman dalam mewujudkan pembangunan
                Desa Hukaea yang maju, mandiri, dan berkelanjutan.
            </p>

        </div>

        <!-- VISI -->

        <div
            class="mx-auto mt-14 max-w-5xl rounded-3xl border border-green-100 bg-white p-7 shadow-lg md:p-8"
        >

            <div class="flex items-start gap-5">

                <div
                    class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-green-100"
                >

                    <Target
                        class="h-7 w-7 text-green-700"
                    />

                </div>

                <div>

                    <p
                        class="text-sm font-semibold uppercase tracking-[4px] text-green-700"
                    >
                        Visi Desa
                    </p>

                    <h3
                        class="mt-2 text-2xl font-bold leading-relaxed text-slate-900 md:text-3xl"
                    >
                        {village.vision}
                    </h3>

                </div>

            </div>

        </div>

        <!-- MISI -->

        <div class="mt-16">

            <div class="mb-10 text-center">

                <h3
                    class="text-3xl font-bold text-slate-900"
                >
                    Misi Desa
                </h3>

                <p
                    class="mt-3 text-slate-500"
                >
                    Misi adalah rumusan umum mengenai upaya-upaya yang akan dilaksanakan untuk mewujudkan visi.
                </p>

            </div>

            <div
                class="grid gap-6 md:grid-cols-2"
            >

                {
                    village.missions.map((mission, index) => (

                        <div
                            class="group flex gap-5 rounded-3xl border border-white bg-white p-6 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-green-200 hover:shadow-xl"
                        >

                            <div
                                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-green-100 transition duration-300 group-hover:bg-green-600"
                            >

                                <CheckCircle2
                                    class="h-6 w-6 text-green-700 transition duration-300 group-hover:text-white"
                                />

                            </div>

                            <div>

                                <h4
                                    class="text-lg font-bold text-slate-900"
                                >
                                    Misi {index + 1}
                                </h4>

                                <p
                                    class="mt-2 leading-7 text-slate-600"
                                >
                                    {mission}
                                </p>

                            </div>

                        </div>

                    ))
                }

            </div>

        </div>

    </div>

</section>